// UlixOps data model. Starting point: docs/SPEC.md section 14.3.
// Connection URL comes from prisma.config.ts (DATABASE_URL), never from this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN // A134: self-approves risky actions; granted only with `cli grant-super-admin`
  ADMIN
  DEVELOPER
  VIEWER
  CLIENT_VIEWER // A178: tag-scoped read-only; User.viewTag required
}

enum Host {
  WPENGINE
  OTHER
}

enum Conn {
  SSH
  SFTP
  FTPS
  FTP
}

enum TargetStatus {
  QUEUED
  SNAPSHOT
  STAGING
  CHECKING
  DEPLOYING
  DONE
  ROLLED_BACK
  FAILED
  PAUSED
}

enum ChallengeKind {
  TOTP // password accepted, waiting for the authenticator code
  ENROLL // password accepted, 2FA must be set up before a session exists
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  name             String?
  role             Role                @default(VIEWER)
  /**
   * Exactly one site tag for CLIENT_VIEWER (A178). Null for every other role.
   */
  viewTag          String?
  passwordHash     String? // argon2id; null until the setup link is used
  twoFactorEnabled Boolean             @default(false)
  totpSecretEnc    String? // AES-256-GCM (TOTP_ENCRYPTION_KEY), never returned by the API
  totpLastStep     Int? // last accepted TOTP time step, blocks code replay
  active           Boolean             @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime            @default(now())
  sessions         Session[]
  challenges       AuthChallenge[]
  setupTokens      SetupToken[]
  devices          KnownDevice[]
  passkeys         Passkey[]
  webauthn         WebAuthnChallenge[]
}

// Tokens below are stored only as HMAC-SHA256(token, SESSION_SECRET).

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime // absolute limit (12 h)
  revokedAt  DateTime?

  @@index([userId])
}

model AuthChallenge {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ChallengeKind
  attempts  Int           @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}

// One-time link for setting a password (first admin from the CLI, invites in step 4).
model SetupToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceHash  String
  ip          String?
  userAgent   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, deviceHash])
}

// Security events for admins (new-device logins, lockouts). Delivery by email/Slack: step 11.
model SecurityAlert {
  id         String    @id @default(cuid())
  kind       String // NEW_DEVICE_LOGIN | ACCOUNT_LOCKED
  userId     String?
  ip         String?
  userAgent  String?
  meta       Json?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// In-app alert centre rows (Build Order step 11, spec §6.8 / screen 19). One row per recipient.
model Notification {
  id        String    @id @default(cuid())
  kind      String // NotificationEvent in shared
  title     String
  body      String
  severity  String // info | warning | critical
  userId    String
  siteIds   String[]
  meta      Json?
  alertId   String?
  alert     Alert?    @relation(fields: [alertId], references: [id], onDelete: SetNull)
  /**
   * First time the recipient actually looked at it (opened the bell, toast or the page).
   */
  seenAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([alertId])
}

enum AlertStatus {
  INFO
  OPEN
  ACKNOWLEDGED
  RESOLVED
  VERIFIED
  AUTO_CLEARED
}

// One problem (or info event) behind one or more notifications, with its follow-up (A158).
// Repeats of an unclosed problem (same kind, sites and scope) attach to the same Alert.
model Alert {
  id             String         @id @default(cuid())
  kind           String
  title          String
  body           String
  severity       String
  siteIds        String[] // sorted
  /**
   * Narrows the match inside a site, e.g. the environment id or approval id.
   */
  scope          String?
  actionable     Boolean
  status         AlertStatus
  occurrences    Int            @default(1)
  firstRaisedAt  DateTime
  lastRaisedAt   DateTime
  firstSeenAt    DateTime?
  acknowledgedAt DateTime?
  ownerId        String?
  resolvedAt     DateTime?
  resolvedById   String?
  resolution     String? // AlertResolution
  fixAction      String? // FixAction
  resolutionNote String?
  verifiedAt     DateTime?
  verifiedById   String? // null with verifiedAt set = confirmed by a check
  closedAt       DateTime?
  reopenCount    Int            @default(0)
  notifications  Notification[]
  events         AlertEvent[]

  @@index([kind, status])
  @@index([status, lastRaisedAt])
  @@index([firstRaisedAt])
}

// Append-only timeline of an Alert: who saw, took, fixed, confirmed or rejected it.
model AlertEvent {
  id            String   @id @default(cuid())
  alertId       String
  alert         Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  type          String // AlertEventType
  /**
   * Who did it; null = UlixOps (a check or a recovery).
   */
  userId        String?
  /**
   * For CONFIRMED / REJECTED: whose fix was judged.
   */
  subjectUserId String?
  note          String?
  createdAt     DateTime

  @@index([alertId, createdAt])
  @@index([type, createdAt])
  @@index([subjectUserId, type])
}

model Site {
  id             String              @id @default(cuid())
  name           String
  url            String              @unique // production URL
  host           Host
  tags           String[]
  archived       Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  environments   SiteEnvironment[]
  targets        DeploymentTarget[]
  backups        Backup[]
  autoUpdate     AutoUpdateSchedule?
  autoUpdateRuns AutoUpdateRun[]
  siteReports    SiteReport[]
}

enum EnvKind {
  PRODUCTION
  STAGING
}

// How to reach one WordPress install of a site (agent decision A47). No secrets: the SSH key
// lives in the vault and is referenced by name.
model SiteEnvironment {
  id                String                 @id @default(cuid())
  siteId            String
  site              Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  kind              EnvKind
  url               String
  connection        Conn                   @default(SSH)
  sshHost           String
  sshPort           Int                    @default(22)
  sshUser           String
  wpPath            String
  credentialRef     String // vault secret name, never the secret
  hostKey           String? // pinned SSH host key fingerprint, set by the first successful test
  /// Dedicated SFTP for the Files tab (A180/A182). When set, file manager uses this instead of SSH.
  filesSftpHost          String?
  filesSftpPort          Int?
  filesSftpUser          String?
  filesSftpPath          String?
  /// Vault ref: SSH key name (authKind=key) or FILES_SFTP_* password secret (authKind=password).
  filesSftpCredentialRef String?
  /// "key" (default) or "password" — password value lives only in the vault (A182).
  filesSftpAuthKind      String?
  filesSftpHostKey       String?
  lastTestAt        DateTime?
  lastTestOk        Boolean?
  lastTestError     String?
  wpVersion         String?
  phpVersion        String?
  wpCliVersion      String?
  // Last health check (Build Order step 9, spec §6.6).
  lastHealthAt      DateTime?
  lastHealthOk      Boolean?
  lastHealthSummary String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt
  inventory         SiteInventory?
  jobs              SiteJob[]
  lock              SiteEnvironmentLock?
  backups           Backup[]
  deployTargets     DeploymentTarget[]
  vulnFindings      VulnerabilityFinding[]
  malwareScans      MalwareScan[]
  /// Include in scheduled malware scans (A143); manual scans always allowed.
  malwareAutoScan   Boolean                @default(true)
  malwareIgnores    MalwareIgnore[]
  integrityChecks   IntegrityCheck[]
  integrityIgnores  IntegrityIgnore[]
  /// Include in the weekly Google Drive backup (A145).
  backupAutoEnabled Boolean                @default(true)
  fullBackups       FullBackup[]
  fullRestores      FullRestore[]
  phpErrorLog       PhpErrorLog?
  sslCertificate    SslCertificate?
  /// Include in uptime monitoring (A149); production only.
  uptimeEnabled     Boolean                @default(true)
  uptimeMonitor     UptimeMonitor?
  uptimeChecks      UptimeCheck[]
  uptimeIncidents   UptimeIncident[]
  visualChecks      VisualCheck[]

  @@unique([siteId, kind])
}

// Spec section 7 "SiteSnapshot": the environment's inventory read over WP-CLI, refreshed on
// demand. Named SiteInventory so it isn't confused with quick snapshots (agent decision A56).
// One row per environment, replaced on every refresh.
model SiteInventory {
  id                String          @id @default(cuid())
  environmentId     String          @unique
  environment       SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  refreshedAt       DateTime
  refreshedById     String?
  wpVersion         String
  phpVersion        String
  wpCliVersion      String
  activeTheme       String?
  maintenance       Boolean?
  safeMode          Boolean         @default(false)
  warnings          String[]
  plugins           Json // InventoryItem[] (packages/shared), validated on read
  themes            Json // InventoryItem[]
  /// Newest WordPress release offered at the last Check for updates (A135); null when current.
  coreUpdateVersion String?
  /// When update sources were last asked; null means "Up to date" can't be claimed (A135).
  updatesCheckedAt  DateTime?
}

// "One command at a time" per environment (agent decision A60). The primary key makes the
// claim atomic: a second concurrent claim fails to insert. A lock older than SITE_JOB_STALE_MS
// (the API stopped mid-job) is taken over with a conditional update, so it can't block forever.
model SiteEnvironmentLock {
  environmentId String          @id
  environment   SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  token         String // random per claim; only its holder releases it
  lockedAt      DateTime
}

enum SiteJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// Job log for remote work on one environment (spec screen 5 "Logs: job logs"): what ran, who
// asked, the result and the command output as the runner returned it, already redacted.
model SiteJob {
  id            String          @id @default(cuid())
  siteId        String
  environmentId String
  environment   SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  action        String // inventory.refresh | plugin.activate | plugin.deactivate | maintenance | cache.flush
  params        Json
  status        SiteJobStatus   @default(RUNNING)
  exitCode      Int?
  output        String          @default("")
  requestedById String?
  startedAt     DateTime
  finishedAt    DateTime?

  @@index([siteId, startedAt])
  @@index([environmentId, status])
}

// Ulix Digital's own plugins (spec 6.3). The slug is the plugin's folder name, which is also
// how WP-CLI names it in each site's inventory, so installed versions are tracked by slug.
model Plugin {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String // from the latest upload's "Plugin Name:" header
  createdAt DateTime        @default(now())
  versions  PluginVersion[]
}

model PluginVersion {
  id           String       @id @default(cuid())
  pluginId     String
  plugin       Plugin       @relation(fields: [pluginId], references: [id])
  version      String // from the ZIP's "Version:" header
  sha256       String
  storageKey   String // path inside PLUGIN_STORE_DIR, e.g. versions/<sha256>.zip
  sizeBytes    Int
  changelog    String
  dbChanging   Boolean      @default(false)
  requiresWp   String?
  requiresPhp  String?
  uploadedById String?
  createdAt    DateTime     @default(now())
  deployments  Deployment[]

  @@unique([pluginId, version])
}

// A ZIP that passed every check and waits, quarantined, for its changelog (agent decision A63).
// The file is uploads/<id>.zip in PLUGIN_STORE_DIR; both expire after PLUGIN_UPLOAD_TTL_MS.
model PluginUpload {
  id           String   @id @default(cuid())
  sha256       String
  sizeBytes    Int
  filename     String
  slug         String
  name         String
  version      String
  requiresWp   String?
  requiresPhp  String?
  uploadedById String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

// Custom-plugin rollout (Build Order step 10, spec §6.4). Status is DeploymentStatus in shared.
model Deployment {
  id              String             @id @default(cuid())
  pluginVersionId String
  pluginVersion   PluginVersion      @relation(fields: [pluginVersionId], references: [id])
  requestedById   String
  approvedById    String?
  approvalId      String?
  stagingFirst    Boolean            @default(true)
  batchSize       Int                @default(2)
  pauseOnFailure  Boolean            @default(true)
  status          String // PENDING_APPROVAL | QUEUED | RUNNING | PAUSED | SUCCEEDED | FAILED | CANCELLED
  createdAt       DateTime           @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  targets         DeploymentTarget[]

  @@index([createdAt])
  @@index([status])
}

model DeploymentTarget {
  id            String          @id @default(cuid())
  deploymentId  String
  deployment    Deployment      @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  siteId        String
  site          Site            @relation(fields: [siteId], references: [id])
  environmentId String
  environment   SiteEnvironment @relation(fields: [environmentId], references: [id])
  kind          EnvKind
  status        TargetStatus    @default(QUEUED)
  log           String          @default("")
  backupId      String?
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([deploymentId, status])
  @@index([siteId])
}

// Quick pre-update snapshot (spec §6.5) or a later full backup. Location is a path inside
// SNAPSHOT_STORE_DIR; the encrypted bytes are written by the runner (agent decision A68).
model Backup {
  id            String          @id @default(cuid())
  siteId        String
  site          Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  environmentId String
  environment   SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  kind          String // QUICK_SNAPSHOT | FULL
  status        String          @default("PENDING") // PENDING | READY | FAILED | EXPIRED
  pluginName    String?
  pluginVersion String?
  includesDb    Boolean         @default(false)
  location      String // e.g. quick/<id>.bin — never a user-supplied path
  sha256        String?
  sizeBytes     Int?
  encrypted     Boolean         @default(true)
  expiresAt     DateTime?
  createdById   String?
  createdAt     DateTime        @default(now())
  restoredAt    DateTime?

  @@index([siteId, createdAt])
  @@index([environmentId, createdAt])
  @@index([expiresAt])
  @@index([status])
}

model ApprovalRequest {
  id            String    @id @default(cuid())
  action        String
  payload       Json
  requestedById String
  decidedById   String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  comment       String?
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  siteIds   String[]
  ip        String?
  result    String
  meta      Json?
  createdAt DateTime @default(now())
  // append-only: DB role has INSERT/SELECT only on this table
}

// Hub settings edited by Admins (e.g. the IP allowlist). Values never hold secrets.
model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String?
}

// WebAuthn passkeys, a second factor alongside TOTP (agent decision A45).
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique // base64url
  publicKey    Bytes // COSE public key; not a secret
  counter      BigInt    @default(0)
  transports   String[]
  name         String
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// One random challenge per passkey ceremony; single use, short-lived.
model WebAuthnChallenge {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose          String // REGISTER | LOGIN
  challenge        String
  /// For LOGIN: the password-step AuthChallenge this ceremony belongs to.
  loginChallengeId String?
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, purpose])
}

// Phase 2 step 2 (A131): Wordfence Intelligence records for software installed on our sites.
// Upserted on every feed sync; `software` holds VulnSoftware[] (packages/shared), validated on read.
model Vulnerability {
  id           String                 @id // Wordfence record id (UUID)
  title        String
  severity     String // critical | high | medium | low | unknown
  cvssScore    Float?
  cve          String?
  reference    String?
  publishedAt  DateTime?
  software     Json
  /// softwareKey() of every entry in `software`, for indexed lookups ("plugin:akismet").
  softwareKeys String[]
  syncedAt     DateTime
  findings     VulnerabilityFinding[]

  @@index([softwareKeys], type: Gin)
}

// One vulnerable (record, software) pair on one environment. Resolved when the installed
// version is no longer affected; reopened if it becomes affected again.
model VulnerabilityFinding {
  id               String          @id @default(cuid())
  environmentId    String
  environment      SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  vulnerabilityId  String
  vulnerability    Vulnerability   @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  softwareType     String // core | plugin | theme
  slug             String
  installedVersion String
  fixedIn          String?
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  resolvedAt       DateTime?

  @@unique([environmentId, vulnerabilityId, softwareType, slug])
  @@index([environmentId, resolvedAt])
  @@index([resolvedAt])
}

// Phase 2 step 3 (A138): Wordfence CLI malware scans of a copy of the site's code.
model MalwareScan {
  id            String           @id @default(cuid())
  environmentId String
  environment   SiteEnvironment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  status        String // QUEUED | RUNNING | CLEAN | INFECTED | FAILED | CANCELLED (A143)
  requestedById String? // null for the schedule
  /// When it was asked for; startedAt is when it actually started (same until then).
  queuedAt      DateTime         @default(now())
  startedAt     DateTime
  finishedAt    DateTime?
  /// Live progress while RUNNING (A143): copying | clamav | yara.
  phase         String?
  progress      Int              @default(0)
  scannedFiles  Int              @default(0)
  cancelledById String?
  files         Int              @default(0)
  bytes         BigInt           @default(0)
  truncated     Boolean          @default(false)
  detail        String?
  findings      MalwareFinding[]

  @@index([environmentId, startedAt])
  @@index([status])
}

model MalwareFinding {
  id            String      @id @default(cuid())
  scanId        String
  scan          MalwareScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  path          String
  signatureId   String
  signatureName String
  description   String
  /// Matched a "known safe" rule (MalwareIgnore) when stored, or marked safe later (A143).
  ignored       Boolean     @default(false)

  @@index([scanId])
}

// "Known safe" malware matches per environment (A143): a file + signature an Admin reviewed.
// Later scans still record the match but don't count or alert on it.
model MalwareIgnore {
  id            String          @id @default(cuid())
  environmentId String
  environment   SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  path          String
  signatureId   String
  reason        String
  createdById   String
  createdAt     DateTime

  @@unique([environmentId, path, signatureId])
}

// Phase 2 step 4 (A144): WordPress core and WordPress.org plugins against official checksums.
model IntegrityCheck {
  id              String             @id @default(cuid())
  environmentId   String
  environment     SiteEnvironment    @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  status          String // RUNNING | CLEAN | CHANGED | FAILED
  requestedById   String? // null for the schedule
  startedAt       DateTime
  finishedAt      DateTime?
  coreChecked     Boolean            @default(false)
  pluginsChecked  Boolean            @default(false)
  verifiedPlugins Int                @default(0)
  /// Plugins WordPress.org has no checksums for (premium, custom).
  unverifiable    String[]
  detail          String?
  findings        IntegrityFinding[]

  @@index([environmentId, startedAt])
  @@index([status])
}

model IntegrityFinding {
  id        String         @id @default(cuid())
  checkId   String
  check     IntegrityCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  scope     String // core | plugin
  component String // "wordpress" or the plugin slug
  path      String // from the site root (core) or within the plugin
  issue     String // modified | added | missing
  /// Matched a known-safe rule (IntegrityIgnore).
  ignored   Boolean        @default(false)

  @@index([checkId])
}

// Deliberate changes an Admin reviewed (A144): later checks record but don't count or alert.
model IntegrityIgnore {
  id            String          @id @default(cuid())
  environmentId String
  environment   SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  scope         String
  component     String
  path          String
  reason        String
  createdById   String
  createdAt     DateTime

  @@unique([environmentId, scope, component, path])
}

// Phase 2 step 5 (A145): full encrypted backups on Google Drive. One READY copy per environment;
// older ones become REMOVED once a newer one is verified and they are deleted from Drive.
model FullBackup {
  id            String          @id @default(cuid())
  environmentId String
  environment   SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  status        String // QUEUED | RUNNING | READY | FAILED | SKIPPED | CANCELLED | REMOVED
  requestedById String? // null for the schedule
  queuedAt      DateTime
  startedAt     DateTime
  finishedAt    DateTime?
  phase         String? // database | uploading | verifying | cleanup (while RUNNING)
  progress      Int             @default(0)
  bytes         BigInt          @default(0)
  driveFileId   String?
  fileName      String?
  md5           String?
  webViewLink   String?
  detail        String?
  cancelledById String?
  removedAt     DateTime?
  purpose       String          @default("WEEKLY") // WEEKLY | SAFETY (taken before a restore, A152)
  expiresAt     DateTime? // safety copies are deleted from Drive then
  restoredFrom  FullRestore[]   @relation("RestoreSource")
  safetyFor     FullRestore[]   @relation("RestoreSafety")

  @@index([environmentId, queuedAt])
  @@index([status])
}

// Restore of a full backup from Google Drive (A152). Asked for, approved by a second Admin (or a
// Super Admin's self-approval), then run one at a time: safety copy first, then the restore.
model FullRestore {
  id             String          @id @default(cuid())
  environmentId  String
  environment    SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  sourceId       String
  source         FullBackup      @relation("RestoreSource", fields: [sourceId], references: [id], onDelete: Cascade)
  scope          String // ALL | DATABASE | FILES
  status         String // PENDING_APPROVAL | QUEUED | RUNNING | SUCCEEDED | FAILED | REJECTED | CANCELLED
  approvalId     String?
  requestedById  String
  approvedById   String?
  createdAt      DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  phase          String?
  progress       Int             @default(0)
  detail         String?
  safetyBackupId String?
  safetyBackup   FullBackup?     @relation("RestoreSafety", fields: [safetyBackupId], references: [id], onDelete: SetNull)
  healthOk       Boolean?
  healthSummary  String?

  @@index([environmentId, createdAt])
  @@index([status])
}

// SSL certificate per environment, replaced on every check (Phase 3 step 1, A148). Alert state
// is kept per expiry date, so a renewed certificate alerts again from its first threshold.
model SslCertificate {
  environmentId  String          @id
  environment    SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  host           String
  https          Boolean
  checkedAt      DateTime
  ok             Boolean
  validFrom      DateTime?
  validTo        DateTime?
  issuer         String?
  subject        String?
  altNames       String[]
  error          String?
  /// Registered domain of this host (production, not a hosting provider's name).
  domain         String?
  alertedDays    Int?
  alertedValidTo DateTime?
  /// An "untrusted / unreachable" alert went out; cleared when the certificate is fine again.
  alertedInvalid Boolean         @default(false)

  @@index([domain])
}

// Domain registration expiry from the registry's RDAP service (A148). manualExpiresAt is an
// Admin-entered date for registries that publish none.
model DomainRegistration {
  domain           String    @id
  status           String // found | unsupported | not_found | error
  checkedAt        DateTime?
  expiresAt        DateTime?
  registrar        String?
  error            String?
  manualExpiresAt  DateTime?
  manualSetById    String?
  alertedDays      Int?
  alertedExpiresAt DateTime?
}

// Uptime monitoring (Phase 3 step 2, A149). UptimeMonitor holds the latest result and the
// failure streak per environment; UptimeCheck keeps every probe for 30 days (uptime %);
// UptimeIncident records each outage (two failed checks in a row until the next good one).
model UptimeMonitor {
  environmentId String          @id
  environment   SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  checkedAt     DateTime
  ok            Boolean
  status        Int?
  responseMs    Int?
  error         String?
  /// Failed checks in a row.
  failures      Int             @default(0)
  /// Time of the first failed check in the current streak.
  failingSince  DateTime?
  /// The open incident, while the site is down.
  incidentId    String?
}

model UptimeCheck {
  id            String          @id @default(cuid())
  environmentId String
  environment   SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  checkedAt     DateTime
  ok            Boolean
  status        Int?
  responseMs    Int?
  error         String?
  /// A hub job held the site (deploy, update): not counted towards "down".
  excluded      Boolean         @default(false)

  @@index([environmentId, checkedAt])
  @@index([checkedAt])
}

model UptimeIncident {
  id            String          @id @default(cuid())
  environmentId String
  environment   SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  startedAt     DateTime
  endedAt       DateTime?
  /// recovered | paused
  endReason     String?
  /// Why the first failed check failed.
  error         String?
  failedChecks  Int             @default(0)

  @@index([environmentId, startedAt])
  @@index([startedAt])
}

// Cloudflare DNS (Phase 3 step 3, A156). Zones the token can see, refreshed every 6 hours and
// on demand; every read of a zone's records is compared with its last snapshot, so changes made
// outside UlixOps raise an alert. Snapshots are taken before and after every UlixOps change.
model DnsZone {
  id                  String        @id // Cloudflare zone id
  name                String        @unique
  status              String
  paused              Boolean       @default(false)
  accountName         String?
  plan                String?
  nameServers         String[]
  originalNameServers String[]
  recordCount         Int           @default(0)
  checklist           Json          @default("{}")
  firstSeenAt         DateTime
  lastSyncAt          DateTime?
  removedAt           DateTime? // the token no longer sees it
  snapshots           DnsSnapshot[]
  changes             DnsChange[]
  rollbacks           DnsRollback[]
}

model DnsSnapshot {
  id          String        @id @default(cuid())
  zoneId      String
  zone        DnsZone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  takenAt     DateTime
  reason      String // first | sync | before-change | after-change | before-rollback | after-rollback
  takenById   String?
  records     Json
  recordCount Int
  fingerprint String
  rollbacks   DnsRollback[]

  @@index([zoneId, takenAt])
}

model DnsChange {
  id      String   @id @default(cuid())
  zoneId  String
  zone    DnsZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  at      DateTime
  userId  String?
  kind    String // create | update | delete | rollback | purge | external
  summary String
  lines   String[]
  ok      Boolean

  @@index([zoneId, at])
}

model DnsRollback {
  id            String      @id @default(cuid())
  zoneId        String
  zone          DnsZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  snapshotId    String
  snapshot      DnsSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  status        String // PENDING_APPROVAL | APPROVED | APPLIED | FAILED | REJECTED
  approvalId    String?
  requestedById String
  createdAt     DateTime
  finishedAt    DateTime?
  detail        String?

  @@index([zoneId, createdAt])
}

// Latest reading of wp-content/debug.log per environment (Phase 4 step 1, A159): grouped
// messages, 24-hour counts, and the newest fatal error already alerted on.
model PhpErrorLog {
  environmentId String          @id
  environment   SiteEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  readAt        DateTime
  ok            Boolean
  detail        String?
  fileFound     Boolean         @default(false)
  sizeBytes     BigInt          @default(0)
  modifiedAt    DateTime?
  truncated     Boolean         @default(false)
  groups        Json            @default("[]")
  fatal24h      Int             @default(0)
  errors24h     Int             @default(0)
  warnings24h   Int             @default(0)
  lastFatalAt   DateTime?
  // wp-config.php debug constants at the last reading (A160).
  debug         Json?
  // UlixOps switched logging on; previousDebug is what to put back.
  managed       Boolean         @default(false)
  previousDebug Json?
  managedAt     DateTime?
  managedById   String?
}

// Scheduled updates per site (Phase 4 step 2, A162). Off by default; switching on needs an
// approved ApprovalRequest. skip / holds are Zod-checked JSON lists (AutoUpdateSkip/Hold).
model AutoUpdateSchedule {
  siteId       String    @id
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  enabled      Boolean   @default(false)
  dayOfWeek    Int       @default(2)
  hourUtc      Int       @default(6)
  skip         Json      @default("[]")
  holds        Json      @default("[]")
  enabledAt    DateTime?
  // Start of the last window a run was started for (one run per window).
  lastWindowAt DateTime?
  updatedAt    DateTime  @default(now()) @updatedAt
  updatedById  String?
}

// One scheduled run of a site: staging then production, items and outcomes in `report`.
model AutoUpdateRun {
  id         String    @id @default(cuid())
  siteId     String
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  windowAt   DateTime
  startedAt  DateTime
  finishedAt DateTime?
  status     String
  report     Json      @default("{}")
  updated    Int       @default(0)
  problems   Int       @default(0)

  @@index([siteId, startedAt])
}

// Before/after visual check of public pages (Phase 4 P4-3, A163). PNGs live on visual-store
// under /data/visual/<id>/; this row holds the outcome and page metadata.
enum VisualCheckTrigger {
  deploy
  update
  core_update
  autoupdate
  manual
}

enum VisualCheckStatus {
  PENDING
  CAPTURING_BEFORE
  WAITING
  CAPTURING_AFTER
  CLEAN
  CHANGED
  FAILED
  SKIPPED
}

model VisualCheck {
  id                  String             @id @default(cuid())
  environmentId       String
  environment         SiteEnvironment    @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  trigger             VisualCheckTrigger
  status              VisualCheckStatus  @default(PENDING)
  summary             String             @default("")
  maxDiffPercent      Float
  pixelThreshold      Float
  viewportWidth       Int
  viewportHeight      Int
  deploymentId        String?
  deploymentTargetId  String?
  requestedById       String?
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?
  pages               VisualPage[]

  @@index([environmentId, startedAt])
  @@index([status, startedAt])
}

model VisualPage {
  id           String      @id @default(cuid())
  checkId      String
  check        VisualCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  path         String
  slug         String
  role         String
  url          String
  ok           Boolean     @default(false)
  httpStatus   Int?
  detail       String      @default("")
  diffPercent  Float?
  changed      Boolean     @default(false)
  hasBefore    Boolean     @default(false)
  hasAfter     Boolean     @default(false)
  hasDiff      Boolean     @default(false)

  @@index([checkId])
}

// Monthly site report (Phase 4 P4-4, A164 → A165). One row per site per UTC month; summary
// JSON is the source of truth so PDFs can be regenerated without a disk store.
enum SiteReportStatus {
  READY
  FAILED
}

model SiteReport {
  id            String           @id @default(cuid())
  siteId        String
  site          Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  status        SiteReportStatus @default(READY)
  summary       Json?
  detail        String?
  generatedAt   DateTime         @default(now())
  generatedById String?
  emailedAt     DateTime?
  emailedTo     String[]         @default([])

  @@unique([siteId, periodStart])
  @@index([generatedAt])
  @@index([siteId])
}
