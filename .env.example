# UlixOps environment variables: NAMES ONLY. Never put values in this file.
# Copy to .env (git-ignored) for local development. In production, values come from Infisical.
# Generate local passwords with: openssl rand -hex 32   (hex keeps them URL-safe)

# --- Spec section 14.4 ---
# PostgreSQL connection for the API, as the restricted app role
# (host-run dev: postgresql://ulixops_app:<APP_DB_PASSWORD>@localhost:5432/ulixops)
DATABASE_URL=
# BullMQ queue (host-run dev: redis://:<REDIS_PASSWORD>@localhost:6379)
REDIS_URL=
# Session signing (from vault)
SESSION_SECRET=
# Vault access: the runner's machine identity, written by vault-setup (runner only, A46)
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
# WP Engine API
WPENGINE_API_USER=
WPENGINE_API_PASSWORD=
# Email notifications
SMTP_URL=
# Slack notifications (optional)
SLACK_WEBHOOK_URL=
# Vault ref for Drive service account (Phase 2)
GOOGLE_DRIVE_SA_JSON_REF=
# Vault ref for DNS-scoped token (Phase 3)
CLOUDFLARE_API_TOKEN_REF=
# IP allowlist
ALLOWED_IPS=
# Default 7 (also editable in Settings)
SNAPSHOT_RETENTION_DAYS=
# AES-256 key for encrypted quick snapshots: 64 hex characters (openssl rand -hex 32).
# Only the runner holds this; the API never decrypts (agent decision A69).
SNAPSHOT_ENCRYPTION_KEY=

# --- Local / Docker Compose (agent decision A12) ---
# Database owner password: used only by the migrate service (and MIGRATION_DATABASE_URL)
POSTGRES_PASSWORD=
# Password of ulixops_app, the API's restricted database role (64 hex: openssl rand -hex 32)
APP_DB_PASSWORD=
# Host-run migrations as the owner: postgresql://ulixops:<POSTGRES_PASSWORD>@localhost:5432/ulixops
MIGRATION_DATABASE_URL=
# Redis password used by docker-compose.yml to build REDIS_URL for the api and runner
REDIS_PASSWORD=
# Database password for the disposable test WordPress site (compose profile "testsite")
TEST_WP_DB_PASSWORD=
# Base URL the web app uses to call the API (default http://localhost:4000)
API_URL=
# Port the API listens on (default 4000)
API_PORT=
# Parallel jobs per runner (default 2)
RUNNER_CONCURRENCY=
# Absolute folder for uploaded plugin ZIPs, outside any web root (default /data/plugins, a
# compose volume; host-run dev: e.g. <repo>/.dev/plugin-store)
PLUGIN_STORE_DIR=
# Absolute folder for encrypted quick snapshots (default /data/snapshots; shared by api + runner)
SNAPSHOT_STORE_DIR=

# --- Auth (Build Order step 2, agent decisions A22-A31) ---
# AES-256 key for TOTP secrets at rest: 64 hex characters (openssl rand -hex 32)
TOTP_ENCRYPTION_KEY=
# Base URL people open the hub on; used in setup links (default http://localhost:3000)
PUBLIC_URL=
# Header holding the visitor's IP. Empty locally; cf-connecting-ip behind Cloudflare
CLIENT_IP_HEADER=

# --- Self-hosted vault (Build Order step 5, agent decision A46) ---
# Infisical's data key: 32 hex characters (openssl rand -hex 16)
INFISICAL_ENCRYPTION_KEY=
# Infisical's session signing key (openssl rand -base64 32)
INFISICAL_AUTH_SECRET=
# Passwords of the vault's own Postgres and Redis (openssl rand -hex 32)
INFISICAL_DB_PASSWORD=
INFISICAL_REDIS_PASSWORD=
# URL the vault UI is opened on (default http://localhost:8081; on the VPS via an SSH tunnel)
INFISICAL_SITE_URL=
# Vault base URL for a host-run runner (compose sets http://infisical:8080)
INFISICAL_URL=

# --- Tests (local dev and CI only) ---
# Disposable database, rebuilt by the API test suite; its name must end in _test
TEST_DATABASE_URL=
# SSH address of the test site for the runner integration tests: 127.0.0.1:2222 (dev overlay)
TEST_WP_SSH=
# Redis for the rate-limit counter test (e.g. database 15 of the dev Redis)
TEST_REDIS_URL=

# --- Production VPS only (agent decision A19; lives in ~/ulixops.env on the server) ---
# Cloudflare Tunnel connector token (docs/DEPLOY.md step 3)
CLOUDFLARE_TUNNEL_TOKEN=
